# Copy to /etc/legal-chatbot.env. Never commit real secrets.
# Local development should use ENVIRONMENT=development (the application default).

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-64-plus-random-bytes
TRUSTED_HOSTS=api.example.com
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql+asyncpg://legalbot:PASSWORD@127.0.0.1:5432/legalchatbot
ALEMBIC_DATABASE_URL=postgresql://legalbot:PASSWORD@127.0.0.1:5432/legalchatbot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

QDRANT_URL=http://127.0.0.1:6333
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=replace-with-qdrant-api-key

LEGAL_QDRANT_COLLECTION=legal_documents
USER_DOCUMENT_COLLECTION=chatbot_documents
USER_MEMORY_COLLECTION=user_memory
VECTOR_SIZE=768

UPLOAD_DIR=/var/lib/legal-chatbot/documents
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=33554432

LLM_PROVIDER=gemini
CHAT_MODEL=gemini-3.6-flash
LLM_API_KEY=
# Hosted Gemini/OpenAI: 120 is enough. Local DeepSeek R1 32B needs 3600;
# if LLM_PROVIDER=ollama and this is still 120 (or the old 1800), the app
# floors it to 3600 automatically.
LLM_TIMEOUT=120
LLM_ENABLE_STREAMING=true
LLM_FIREWALL_ENABLED=true

# --- Local development (DeepSeek R1 32B via Ollama) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=deepseek-r1:32b
# CHAT_MODEL=deepseek-r1:32b
# LLM_URL=http://127.0.0.1:11434
# LLM_TIMEOUT=3600

# --- Server: no local model files (Ollama / HF download blocked) ---
# EMBEDDING_ONLINE_ONLY=true
# LLM_PROVIDER=openrouter
# LLM_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=minimax/minimax-m2.7:free
# LLM_API_KEY=
# EMBEDDING_PROVIDER=fireworks
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# FIREWORKS_API_KEY=
# WEB_SEARCH_FALLBACK_ON_INSUFFICIENT=false

# --- Dev laptop: HF token downloads model once, runs via fastembed ---
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# HUGGINGFACE_API_KEY=

EMBEDDING_PROVIDER=ollama
# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# LLM_TIMEOUT=120
# Later, switch to a paid model by changing OPENROUTER_MODEL only.
# To use a different vendor later, set LLM_PROVIDER=<adapter> and that
# vendor's key/model — RAG/business logic does not change.

EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest

LOG_ENABLE_REQUEST_LOGGING=true
LOG_ENABLE_RESPONSE_BODY=false
LOG_STORE_CHAT_BODIES=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Set true only when Uvicorn is bound to 127.0.0.1 and Nginx is the sole client.
TRUST_FORWARDED_FOR=true

# Live internet search. auto = Tavily/Brave if a key is set, else DuckDuckGo.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_FALLBACK_ON_INSUFFICIENT=false
