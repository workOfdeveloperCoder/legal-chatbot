# Copy to /etc/legal-chatbot.env. Never commit real secrets.
# Local development should use ENVIRONMENT=development (the application default).

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-64-plus-random-bytes
TRUSTED_HOSTS=api.example.com
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql+asyncpg://legalbot:PASSWORD@127.0.0.1:5432/legalchatbot
ALEMBIC_DATABASE_URL=postgresql://legalbot:PASSWORD@127.0.0.1:5432/legalchatbot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

QDRANT_URL=http://127.0.0.1:6333
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=replace-with-qdrant-api-key

LEGAL_QDRANT_COLLECTION=legal_documents
USER_DOCUMENT_COLLECTION=chatbot_documents
USER_MEMORY_COLLECTION=user_memory
VECTOR_SIZE=768

UPLOAD_DIR=/var/lib/legal-chatbot/documents
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=33554432

LLM_PROVIDER=gemini
CHAT_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_ENABLE_STREAMING=true
LLM_FIREWALL_ENABLED=true

EMBEDDING_PROVIDER=ollama
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest

LOG_ENABLE_REQUEST_LOGGING=true
LOG_ENABLE_RESPONSE_BODY=false
LOG_STORE_CHAT_BODIES=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
# Set true only when Uvicorn is bound to 127.0.0.1 and Nginx is the sole client.
TRUST_FORWARDED_FOR=true
